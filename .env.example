# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe — dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stripe Price IDs — Stripe Dashboard → Products → (preço) → API ID
STRIPE_PRICE_PRO_MONTHLY=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PRO_ANNUAL=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_PRICE_PREMIUM_PLUS_ANNUAL=price_XXXXXXXXXXXXXXXXXXXXXXXX

# URL pública do app (sem barra final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp via Meta Cloud API — developers.facebook.com/apps → (seu app) → WhatsApp → API Setup
# META_WHATSAPP_TOKEN         → Token de Acesso (temporário para teste ou System User para produção)
# META_WHATSAPP_PHONE_NUMBER_ID → "Phone Number ID" na aba API Setup
# META_WHATSAPP_VERIFY_TOKEN  → string que VOCÊ escolhe e repete na configuração do webhook no Meta
META_WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_WHATSAPP_PHONE_NUMBER_ID=XXXXXXXXXXXXXXXXX
META_WHATSAPP_VERIFY_TOKEN=minha-chave-secreta-qualquer

# Número do seu WhatsApp pessoal (somente dígitos, com DDI+DDD, ex: 5511999999999)
WHATSAPP_MY_PHONE=5511999999999

# Seu user_id no Supabase — Dashboard → Authentication → Users → copie o UUID
WHATSAPP_MY_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
